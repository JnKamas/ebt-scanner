# Sign-in and submission require a private 32-byte key, encoded as 64 hex characters.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Put it in .env.local locally; use separate sensitive values for Vercel preview
# and production. Keep each environment's key stable across server instances.
# Rotation makes open tabs reload before submitting; it does not revoke EBT sessions.
EBT_SESSION_BINDING_SECRET=
# EBT login passwords are forwarded over HTTPS by server-side routes, not saved.
# Never place EBT passwords or session cookies in this file or commit them to Git.
# NEXT_PUBLIC_* values are exposed to the browser and must never contain secrets.
